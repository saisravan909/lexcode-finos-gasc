{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "nodes": [
    {
      "unique-id": "case-service",
      "node-type": "service",
      "name": "Case service",
      "description": "Synthetic AML case workflow service.",
      "region": "us-east-1",
      "access_logging": false
    },
    {
      "unique-id": "evidence-store",
      "node-type": "database",
      "name": "Evidence store",
      "description": "Synthetic store for case evidence references.",
      "region": "eu-west-1",
      "access_logging": true
    }
  ],
  "relationships": [
    {
      "unique-id": "case-service-reads-evidence",
      "description": "The case service reads evidence from the controlled evidence store.",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "case-service"
          },
          "destination": {
            "node": "evidence-store"
          }
        }
      },
      "protocol": "HTTPS"
    }
  ],
  "workflow": {
    "human_decision_required": false,
    "ai_can_close_alert": true
  }
}
