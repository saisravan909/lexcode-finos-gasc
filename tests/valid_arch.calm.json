{
  "$schema": "https://finos.org/calm/v1/topology.json",
  "name": "EU-Compliant-AI-Inference-Pipeline",
  "version": "1.0.0",
  "nodes": [
    {
      "id": "node-eu-primary-01",
      "type": "compute",
      "region": "eu-central-1",
      "config": {
        "audit_logging": true,
        "encryption_at_rest": true
      }
    },
    {
      "id": "node-eu-secondary-02",
      "type": "storage",
      "region": "eu-west-1",
      "config": {
        "audit_logging": true,
        "encryption_at_rest": true
      }
    }
  ]
}
