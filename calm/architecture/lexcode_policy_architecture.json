{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "nodes": [
    {
      "unique-id": "case-service",
      "node-type": "service",
      "name": "Case service",
      "description": "Synthetic AML case workflow service.",
      "region": "eu-central-1",
      "access_logging": true
    },
    {
      "unique-id": "evidence-store",
      "node-type": "database",
      "name": "Evidence store",
      "description": "Synthetic store for case evidence references.",
      "region": "eu-west-1",
      "access_logging": true
    }
  ],
  "relationships": [
    {
      "unique-id": "case-service-reads-evidence",
      "description": "The case service reads evidence from the controlled evidence store.",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "case-service"
          },
          "destination": {
            "node": "evidence-store"
          }
        }
      },
      "protocol": "HTTPS"
    }
  ],
  "workflow": {
    "human_decision_required": true,
    "ai_can_close_alert": false
  },
  "controls": {
    "lexcode-policy-controls": {
      "description": "Generated from LEXCODE_INTERNAL_CASE_DATA_001 version 1.0.0. Policy checks are internal controls and do not assert legal compliance.",
      "requirements": [
        {
          "requirement-url": "https://calm.finos.org/release/1.3/meta/control-requirement.json",
          "config": {
            "control-id": "LEXCODE_REGION_BOUNDARY_001",
            "name": "Keep sensitive case processing within the approved trust perimeter",
            "description": "Every modeled service and data store must use a region approved by this synthetic organization policy.",
            "policy-id": "LEXCODE_INTERNAL_CASE_DATA_001",
            "policy-version": "1.0.0",
            "evaluation": {
              "scope": "nodes",
              "field": "region",
              "operator": "in",
              "expected": [
                "eu-central-1",
                "eu-west-1"
              ]
            },
            "ccc-mappings": [
              {
                "id": "CCC.Core.CN06",
                "title": "Restrict Deployments to Trust Perimeter",
                "relationship": "related_control_not_a_residency_mandate"
              }
            ],
            "aigf-reference": null
          }
        },
        {
          "requirement-url": "https://calm.finos.org/release/1.3/meta/control-requirement.json",
          "config": {
            "control-id": "LEXCODE_ACCESS_LOGGING_001",
            "name": "Record access and changes",
            "description": "Every modeled service and data store must enable access and change logging.",
            "policy-id": "LEXCODE_INTERNAL_CASE_DATA_001",
            "policy-version": "1.0.0",
            "evaluation": {
              "scope": "nodes",
              "field": "access_logging",
              "operator": "equals",
              "expected": true
            },
            "ccc-mappings": [
              {
                "id": "CCC.Core.CN04",
                "title": "Log All Access and Changes",
                "relationship": "related_control"
              }
            ],
            "aigf-reference": null
          }
        },
        {
          "requirement-url": "https://calm.finos.org/release/1.3/meta/control-requirement.json",
          "config": {
            "control-id": "LEXCODE_HUMAN_REVIEW_001",
            "name": "Require a human decision for every disposition",
            "description": "An AI assisted workflow may prepare information but must not make the final case disposition.",
            "policy-id": "LEXCODE_INTERNAL_CASE_DATA_001",
            "policy-version": "1.0.0",
            "evaluation": {
              "scope": "workflow",
              "field": "human_decision_required",
              "operator": "equals",
              "expected": true
            },
            "ccc-mappings": [],
            "aigf-reference": {
              "url": "https://github.com/finos/ai-governance-framework/blob/main/docs/_usecases/uc-4_anti-financial-crime-investigation.md",
              "status": "draft"
            }
          }
        },
        {
          "requirement-url": "https://calm.finos.org/release/1.3/meta/control-requirement.json",
          "config": {
            "control-id": "LEXCODE_NO_AUTOMATED_CLOSURE_001",
            "name": "Do not let AI close an alert",
            "description": "An AI assistant may summarize or recommend, but it cannot close an alert or file a report.",
            "policy-id": "LEXCODE_INTERNAL_CASE_DATA_001",
            "policy-version": "1.0.0",
            "evaluation": {
              "scope": "workflow",
              "field": "ai_can_close_alert",
              "operator": "equals",
              "expected": false
            },
            "ccc-mappings": [],
            "aigf-reference": {
              "url": "https://github.com/finos/ai-governance-framework/blob/main/docs/_usecases/uc-4_anti-financial-crime-investigation.md",
              "status": "draft"
            }
          }
        }
      ]
    }
  }
}
